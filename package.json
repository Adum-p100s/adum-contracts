{
  "name": "adum-contracts",
  "version": "0.3.0",
  "private": true,
  "description": "Shared zod schemas and types for ADUM",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "import": "./dist/samples.js"
    },
    "./mock-map.json": "./mock/mock-map.json"
  },
  "files": [
    "dist",
    "src",
    "mock"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:mock": "tsx scripts/build-mock-map.ts"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
